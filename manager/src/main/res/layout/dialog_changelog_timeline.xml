<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp"
            app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_autorenew"
                app:tint="?attr/colorOnSecondaryContainer"
                android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/changelog_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_chip"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changelog_sort_newest"
            app:chipIcon="@drawable/ic_outline_expand_more_24" />
    </LinearLayout>

    <include
        android:id="@+id/style_picker"
        layout="@layout/view_changelog_style_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="32dp"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false"
            app:chipSpacingHorizontal="8dp" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_changelog_release" />

    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="@string/changelog_filter_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/m3e_spacing_large"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tour"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/onboarding_take_tour"
            app:icon="@drawable/ic_sparkle_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_github"
            style="?attr/materialIconButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/changelog_view_on_github"
            android:tooltipText="@string/changelog_view_on_github"
            app:icon="@drawable/ic_outline_open_in_new_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changelog_close" />
    </LinearLayout>
</LinearLayout>
