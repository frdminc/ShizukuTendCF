<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Header: tonal icon container + "What's New" title + version/date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:cardElevation="0dp"
            app:shapeAppearance="?attr/shapeAppearanceCornerLarge"
            app:cardBackgroundColor="?attr/colorSecondaryContainer">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_autorenew"
                app:tint="?attr/colorOnSecondaryContainer"
                android:importantForAccessibility="no" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/changelog_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <TextView
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="r2700 · Sep 24, 2026" />

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/style_picker"
        layout="@layout/view_changelog_style_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Notes body — expands to fill available space, scrollable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/notes_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:paddingBottom="4dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <TextView
            android:id="@+id/notes_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:lineSpacingMultiplier="1.35"
            tools:text="- Fixed app list margins\n- Added device control card" />

    </androidx.core.widget.NestedScrollView>

    <!-- Earlier releases section — hidden when there are no previous releases -->
    <LinearLayout
        android:id="@+id/earlier_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/earlier_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="2dp"
            android:text="@string/changelog_version_history"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <HorizontalScrollView
            android:id="@+id/earlier_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="@dimen/margin_horizontal"
            android:paddingVertical="6dp"
            android:clipToPadding="false">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/earlier_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:chipSpacingHorizontal="8dp" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/m3e_spacing_large"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tour"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/onboarding_take_tour"
            app:icon="@drawable/ic_sparkle_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_github"
            style="?attr/materialIconButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/changelog_view_on_github"
            android:tooltipText="@string/changelog_view_on_github"
            app:icon="@drawable/ic_outline_open_in_new_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/changelog_close" />

    </LinearLayout>

</LinearLayout>
