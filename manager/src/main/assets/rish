#!/system/bin/sh
BASEDIR=$(dirname "$0")
DEX="$BASEDIR"/rish_shizuku.dex

if [ ! -f "$DEX" ]; then
  echo "Cannot find $DEX, please check the tutorial in Shizuku app"
  exit 1
fi

if [ $(getprop ro.build.version.sdk 2>/dev/null || echo 0) -ge 34 ]; then
  if [ -w "$DEX" ]; then
    chmod 444 "$DEX" 2>/dev/null || chmod a-w "$DEX" 2>/dev/null
  fi
  if [ -w "$DEX" ]; then
    # File is on a filesystem where chmod a-w is ineffective (e.g. FUSE/sdcard).
    # Transparently cache a read-only copy in TMPDIR or /data/local/tmp.
    _CACHED_DEX="${TMPDIR:-/data/local/tmp}/.rish_shizuku_$(id -u 2>/dev/null || echo 0).dex"
    if [ ! -f "$_CACHED_DEX" ] || [ "$DEX" -nt "$_CACHED_DEX" ]; then
      cp -f "$DEX" "$_CACHED_DEX" 2>/dev/null
      chmod 400 "$_CACHED_DEX" 2>/dev/null || chmod 444 "$_CACHED_DEX" 2>/dev/null || chmod a-w "$_CACHED_DEX" 2>/dev/null
    fi
    if [ -f "$_CACHED_DEX" ] && [ ! -w "$_CACHED_DEX" ]; then
      DEX="$_CACHED_DEX"
    else
      echo "Cannot remove write permission of $DEX."
      echo "Copy the file to the terminal app's private directory (/data/data/<package>) so write permissions can be removed."
      exit 1
    fi
  fi
fi

# Sanitize dynamic loader to prevent cross-UID crashes in ADB mode
unset LD_PRELOAD

# Determine calling application ID
if [ -z "$RISH_APPLICATION_ID" ]; then
  if [ -n "$TERMUX_VERSION" ] || [ -n "$TERMUX_APP_PID" ]; then
    export RISH_APPLICATION_ID="com.termux"
  fi
fi

if [ -z "$RISH_APPLICATION_ID" ]; then
  _pid=$PPID
  _i=0
  while [ -n "$_pid" ] && [ "$_pid" != "0" ] && [ "$_i" -lt 8 ]; do
    _name=$(cat "/proc/$_pid/cmdline" 2>/dev/null | tr '\0' '\n' | head -n 1 | sed 's/:.*//')
    case "$_name" in
      */*) : ;;
      *.*) export RISH_APPLICATION_ID="$_name"; break ;;
    esac
    _pid=$(grep -a '^PPid:' "/proc/$_pid/status" 2>/dev/null | sed 's/[^0-9]//g')
    _i=$((_i + 1))
  done
fi

# Set SHIZUKU_TOKEN if you have authentication enabled in Shizuku app
# [ -z "$SHIZUKU_TOKEN" ] && export SHIZUKU_TOKEN="YOUR_TOKEN_HERE"

# Termux (and other terminal apps) can export LD_LIBRARY_PATH pointing at their own libraries. On
# ColorOS/realme (Android 14+) app_process then loads Termux's libzstd.so, which clashes with the
# system libunwindstack.so, and fails to link. app_process only needs the system libraries.
unset LD_LIBRARY_PATH

exec /system/bin/app_process -Djava.class.path="$DEX" /system/bin --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
